# Absolute path to a user-owned, unmodified US Super Mario 64 big-endian ROM.
# The prepare command reads it in place and never copies it into this repository.
SM64_ROM=/absolute/path/to/baserom.us.z64

# Optional repo-relative overrides. Keep every root ignored and local.
SM64_UPSTREAM_ROOT=.local/upstreams
SM64_GENERATED_ROOT=build/generated/prepare/super-mario-64/title-head
SM64_REPORT_ROOT=build/reports/prepare/super-mario-64
